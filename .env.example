# ==========================================
# MUSE2API environment variable examples
# Copy to .env to take effect: cp .env.example .env
# ==========================================

# [Required/optional] Admin and API auth key (starts with m2a_).
# If left empty, the program auto-generates a strong random key on first startup and prints it to the console log.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# Service listen address and port (set to 0.0.0.0 inside a Docker container)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Public external access address (for downstream clients and for the admin page to build URLs, e.g. https://api.yourdomain.com)
# When empty, the admin page automatically uses the host and port of the current browser visit
MUSE2API_PUBLIC_BASE=

# Chromium browser executable path
# On Linux/Docker this is usually /usr/bin/chromium or /usr/bin/chromium-browser
# For local Windows runs, set the full Chrome path or leave empty for auto-detection
MUSE2API_CHROMIUM=/usr/bin/chromium

# CDP remote debugging port
MUSE2API_CDP_PORT=19210

# Task timeout controls (in seconds)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Max concurrent generation tasks (raise freely to match server resources; default 2)
MUSE2API_CONCURRENCY=2

# Whether to auto-keepalive accounts disabled in the backend (0=off, 1=on)
# When on, disabled accounts still get silent keepalive and session renewal, but are not routed into normal generation or chat
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Reference image safety switch (secure by default; only trusted single-user deployments should consider explicitly setting it to 1)
# 1: allow API requests to read server-local file paths
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1: allow API requests to download intranet/localhost URLs; with 0, each hop is checked and only public IPs are allowed
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0
